{
  "name": "@threshold-labs/integration",
  "version": "0.14.1",
  "description": "Threshold capability contract, auditor prompt, and integration utilities for external apps",
  "type": "module",
  "bin": {
    "threshold-registry": "./dist/cli.js",
    "threshold-dev": "./dist/dev-server.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts/index.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js"
    },
    "./capability": {
      "types": "./dist/capability.d.ts",
      "import": "./dist/capability.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "import": "./dist/signals.js"
    },
    "./memory-connector": {
      "types": "./dist/memory-connector.d.ts",
      "import": "./dist/memory-connector.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "import": "./dist/redact.js"
    },
    "./dev-server": {
      "types": "./dist/dev-server.d.ts",
      "import": "./dist/dev-server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test 'dist/__tests__/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "threshold",
    "integration",
    "trust-graph",
    "signal-push",
    "graph-embedding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Threshold-Labs/threshold-sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
